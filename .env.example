# Variables para Render (Environment). No subir .env al repositorio.

SPRING_PROFILES_ACTIVE=prod

# Neon PostgreSQL
DB_HOST=ep-xxxx-pooler.region.aws.neon.tech
DB_NAME=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=TU_PASSWORD

# Gmail funciona en local; en Render free tier SMTP (587) está bloqueado.
# Opción A: SendGrid SMTP (puerto 2525, no bloqueado por Render)
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=2525
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.tu-api-key-de-sendgrid
# Opción B: Gmail (solo local o Render plan de pago)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail

JWT_SECRET=GENERA_UN_SECRET_LARGO_Y_DIFERENTE_AL_DE_DEV

APP_CORS_ALLOWED_ORIGINS=https://tu-frontend.onrender.com
