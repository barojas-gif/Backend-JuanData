# Copiar como application-dev.properties y completar valores

# ===========================
# SERVIDOR LOCAL
# ===========================
server.port=8080

# ===========================
# BASE DE DATOS LOCAL
# ===========================
spring.datasource.url=jdbc:postgresql://localhost:5432/JuanData?prepareThreshold=0
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# ===========================
# JPA / HIBERNATE
# ===========================
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.jdbc.lob.non_contextual_creation=true

# ===========================
# CORREO
# ===========================
spring.mail.username=tu-correo@gmail.com
spring.mail.password=tu-app-password-de-gmail

# ===========================
# JWT
# ===========================
jwt.secret=GENERA_UN_SECRET_LARGO_Y_ALEATORIO
jwt.expiration-ms=36000000

# ===========================
# CORS
# ===========================
app.cors.allowed-origins=http://localhost:4200

# ===========================
# OPTIMIZACIONES
# ===========================
spring.jpa.properties.javax.persistence.validation.mode=none
server.max-http-request-header-size=40KB
